---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/fonts.css';
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/martian-mono/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../components/shell/shell.css';
import { wipeCss } from '../components/shell/wipe';
import archivoLatin from '../assets/fonts/archivo-latin.woff2?url';
import schibstedLatin from '@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  ground?: 'light' | 'dark';
  image?: string;
  noindex?: boolean;
}
const { title = site.title, description = site.description, ground = 'light', image = '/og.jpg', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(image, Astro.site ?? Astro.url);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={schibstedLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eduard Enache at dusk over the Copenhagen harbour, with the gold horizon line" />
    <meta name="twitter:card" content="summary_large_image" />
    <style is:inline set:html={wipeCss()}></style>
    <ClientRouter />
  </head>
  <body class={ground === 'dark' ? 'ground-water' : 'ground-haze'}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <div class="wipe-line" aria-hidden="true"></div>
    <script>
      import { later } from '../scripts/idle';
      later(() => import('../scripts/motion'));
      import '../scripts/scenes/transitions';
    </script>
  </body>
</html>
