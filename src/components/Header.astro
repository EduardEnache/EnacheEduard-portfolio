---
import { site, nav } from '../data/site';
---
<header class="site-header wrap" data-scene="header">
  <a class="wordmark" href="/">{site.name}</a>
  <nav aria-label="Main">
    <ul>
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
    </ul>
  </nav>
  <span class="mono coords">{site.coordinates}</span>
</header>
<style>
  .site-header { display: flex; align-items: center; gap: var(--space-4); padding-block: var(--space-3); position: relative; z-index: 10; }
  .wordmark { font-family: var(--font-display); font-stretch: 125%; font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; text-decoration: none; margin-right: auto; }
  nav ul { display: flex; gap: var(--space-3); }
  nav a { font-size: var(--fs-sm); text-decoration: none; }
  .coords { display: none; }
  @media (min-width: 900px) { .coords { display: block; } }
</style>
