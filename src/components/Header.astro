---
import { site, nav } from '../data/site';
---
<header class="site-header wrap" data-scene="header" transition:persist="site-header">
  <a class="wordmark" href="/">{site.name}</a>
  <nav aria-label="Main">
    <ul>
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
    </ul>
    <span class="nav-mark" aria-hidden="true" hidden></span>
  </nav>
  <span class="mono coords">{site.coordinates}</span>
</header>
<style>
  .site-header { display: flex; align-items: center; gap: var(--space-4); padding-block: var(--space-3); position: relative; z-index: 10; }
  .wordmark { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-display); font-stretch: 125%; font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; text-decoration: none; margin-right: auto; }
  nav { position: relative; }
  nav ul { display: flex; gap: var(--space-3); }
  nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--fs-sm); text-decoration: none; }
  /* one short gold underline that slides to the current item; only transform animates */
  .nav-mark { position: absolute; left: 0; bottom: 4px; width: var(--space-3); height: 2px; background: var(--accent); transition: transform var(--dur-ui) var(--ease-tide); }
  .coords { display: none; }
  @media (min-width: 900px) { .coords { display: block; } }
</style>
