---
import { artFor, drawable } from './art';

interface Props { slug: string; index: number; title: string; tagline: string; status: string; year: number }
const { slug, index, title, tagline, status, year } = Astro.props;
const n = String(index + 1).padStart(2, '0');
const art = artFor(slug);
---
<li class="spoke" style={`--i:${index}`}>
  <a
    class:list={['card', { on: index === 0 }]}
    href={`/work/${slug}/`}
    data-name={title}
    data-desc={tagline}
    data-stat={`${status} / ${year}`}
  >
    <span class="in" aria-hidden="true">
      <span class={`fa t ${art.theme}`}>
        <span class="num">{n}</span>
        <span class="emblem" transition:name={`emblem-${slug}`}>
          <svg viewBox="0 0 100 100" aria-hidden="true" set:html={drawable(art.svg)} />
        </span>
        <span class="tn">{title}</span>
      </span>
      <span class="band"><span>{n}</span><span>{status}</span></span>
    </span>
    <span class="cap"><b>{title}</b><span>{tagline}</span><i>{status} / {year}</i></span>
  </a>
</li>
