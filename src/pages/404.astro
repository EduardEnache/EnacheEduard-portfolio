---
import Base from '../layouts/Base.astro';
---
<Base title="Not found | Eduard Enache" noindex>
  <section class="nf">
    <script is:inline data-astro-rerun>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.parentElement.classList.add('has-motion');
    </script>
    <div class="sky wrap">
      <p class="mono">404</p>
      <h1>Off the map</h1>
      <p>That page is not here. The horizon is, though.</p>
    </div>
    <!-- the horizon line dips below its own level into the water -->
    <div class="below ground-water">
      <div class="dipbox" aria-hidden="true">
        <svg class="dip" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none">
          <path d="M0 1 H58 C68 1 70 72 80 72 H100" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
        </svg>
        <span class="sq"></span>
      </div>
      <div class="wrap"><a class="btn btn-primary" href="/">Back to the harbour</a></div>
    </div>
  </section>
</Base>
<style>
  .nf { display: grid; grid-template-rows: auto 1fr; min-height: calc(100dvh - 240px); }
  .sky { align-self: end; padding-block: var(--space-5) var(--space-4); }
  h1 { font-size: clamp(40px, 9vw, 128px); margin-block: var(--space-2); }
  .below { position: relative; padding-block: 200px var(--space-5); }
  .dipbox { position: absolute; inset: 0 0 auto 0; height: 160px; color: var(--accent); }
  .dip { width: 100%; height: 100%; display: block; }
  .sq { position: absolute; left: 80%; top: 72%; width: 9px; height: 9px; margin: -4px 0 0 -4.5px; background: var(--accent); }
  .below .btn { color: var(--water-900); }
  .has-motion .dip { animation: nf-draw var(--dur-scene) var(--ease-tide) both; }
  .has-motion .sq { animation: nf-pop var(--dur-ui) var(--ease-tide) calc(var(--dur-scene) * 0.7) both; }
  .has-motion .sky > * { animation: nf-up var(--dur-reveal) var(--ease-tide) both; }
  .has-motion .sky > :nth-child(2) { animation-delay: var(--stagger); }
  .has-motion .sky > :nth-child(3) { animation-delay: calc(var(--stagger) * 2); }
  @keyframes nf-draw { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes nf-pop { from { transform: scale(0); } }
  @keyframes nf-up { from { opacity: 0; transform: translateY(var(--space-2)); } }
</style>
