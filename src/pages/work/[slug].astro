---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectHero from '../../components/project/ProjectHero.astro';
import Numbers from '../../components/project/Numbers.astro';
import Story from '../../components/project/Story.astro';
import Stack from '../../components/project/Stack.astro';
import LiveStrip from '../../components/project/LiveStrip.astro';
import Next from '../../components/project/Next.astro';
import { dataOf } from '../../components/project/data';
import { ditherCss } from '../../components/home/masks';
import '../../components/project/project.css';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, total: all.length, next: all[(i + 1) % all.length] },
  }));
}

const { entry, total, next } = Astro.props;
const data = dataOf(entry);
const { Content } = await render(entry);
const hasStory = (data.story?.length ?? 0) > 0;
---
<Base title={`${data.title} | Eduard Enache`} description={data.tagline} ground="dark">
  <div class="proj" data-scene="project">
    <script is:inline data-astro-rerun>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.parentElement.classList.add('has-motion');
    </script>
    <style is:inline set:html={ditherCss()}></style>
    <ProjectHero slug={entry.id} data={data} total={total} />
    <Numbers data={data} />
    <Story data={data} />
    {!hasStory && (
      <section class="p-story wrap" aria-label="About this project">
        <div class="prose body"><Content /></div>
      </section>
    )}
    <Stack data={data} />
    <LiveStrip data={data} />
    <Next slug={next.id} title={next.data.title} order={next.data.order} />
  </div>
</Base>

<script>
  import { later } from '../../scripts/idle';
  later(() => import('../../scripts/scenes/project'));
</script>

<style>
  .body { max-width: var(--measure); }
  .body :global(p) + :global(p) { margin-top: var(--space-2); }
  .body :global(p) { font-size: var(--fs-md); line-height: 1.45; }
</style>
