---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site, phoneDisplay } from '../../data/site';

const cv = (await getEntry('cv', 'cv'))!.data;
---
<Base title="CV | Eduard Enache" description="Experience, education, skills and certifications of Eduard Enache.">
  <div class="wrap section" data-scene="cv">
    <!-- motion layer switch: absent without JS or with reduced motion, so the page is complete and static -->
    <script is:inline data-astro-rerun>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.parentElement.classList.add('has-motion');
    </script>
    <header>
      <h1>CV</h1>
      <p class="contact-line mono"><a href={`mailto:${site.email}`}>{site.email}</a><a href={`tel:${site.phone}`}>{phoneDisplay}</a></p>
      <p class="cta"><a class="btn btn-primary dl" href={site.cvPdf} download>Download CV</a><span class="mono">PDF</span></p>
      <p class="summary">{cv.summary}</p>
      <hr class="horizon cv-line" />
    </header>

    <!-- one gold line, the horizon turned vertical, joins experience and education -->
    <div class="tl">
      <div class="tl-line" aria-hidden="true"></div>
      <section aria-labelledby="exp">
        <h2 id="exp">Experience</h2>
        <ol class="timeline">
          {cv.roles.map((r) => (
            <li class="role"><span class="node" aria-hidden="true"></span><span class="mono date">{r.start} to {r.end}</span><h3>{r.title}</h3><p>{r.org}{r.place && `, ${r.place}`}</p>
              {r.bullets.length > 0 && <ul class="bullets">{r.bullets.map((b) => <li>{b}</li>)}</ul>}
              {r.tools && <p class="mono tools">Tools: {r.tools}</p>}</li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="edu">
        <h2 id="edu">Education</h2>
        <ol class="timeline">
          {cv.education.map((e) => (
            <li class="role"><span class="node" aria-hidden="true"></span><span class="mono date">{e.start} to {e.end}</span><h3>{e.title}</h3><p>{e.org}</p>{e.detail && <p>{e.detail}</p>}</li>
          ))}
        </ol>
      </section>
    </div>

    {cv.homelab.length > 0 && (
      <section aria-labelledby="lab">
        <h2 id="lab">Home lab</h2>
        <ul class="bullets">{cv.homelab.map((b) => <li>{b}</li>)}</ul>
      </section>
    )}

    <section aria-labelledby="skills">
      <h2 id="skills">Skills</h2>
      <dl class="skills">
        {cv.skills.map((g) => (<div><dt class="mono">{g.group}</dt><dd>{g.items.join(', ')}</dd></div>))}
      </dl>
    </section>

    <section aria-labelledby="certs">
      <h2 id="certs">Certifications</h2>
      <ul class="certs">{cv.certifications.map((c) => <li>{c}</li>)}</ul>
      {cv.workshops.length > 0 && <p class="workshops"><span class="mono">Summits and workshops</span><br />{cv.workshops.join(', ')}</p>}
      <p class="mono">{cv.languages.map((l) => `${l.name}: ${l.level}`).join(' / ')}</p>
    </section>

    <section class="cv-end" aria-label="Download">
      <hr class="horizon" />
      <p class="cta"><a class="btn btn-primary dl" href={site.cvPdf} download>Download CV</a><span class="mono">PDF</span></p>
    </section>
  </div>
</Base>

<script>
  import { later } from '../../scripts/idle';
  later(() => import('../../scripts/scenes/cv'));
</script>

<style>
  .contact-line { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); }
  .contact-line a { display: inline-flex; align-items: center; min-height: 44px; }
  .summary { margin-top: var(--space-3); max-width: 68ch; }
  .bullets { margin-top: var(--space-1); display: grid; gap: 6px; max-width: 68ch; padding-left: 1.1em; list-style: disc; }
  .tools { margin-top: var(--space-1); }
  .workshops { margin-bottom: var(--space-2); }
  .wrap > * + * { margin-top: var(--space-5); }
  header p { margin-top: var(--space-3); }
  header .cv-line { margin-top: var(--space-4); height: 1.5px; transform-origin: left; }
  h2 { font-size: clamp(26px, 8vw, var(--fs-xl)); margin-bottom: var(--space-3); } /* 26px floor: "Certifications" must fit a 320px phone */
  .cta { display: flex; align-items: center; gap: var(--space-2); }
  .dl { padding: 18px 32px; font-size: var(--fs-md); }
  .cv-end .cta { margin-top: var(--space-4); }
  .timeline { display: grid; gap: var(--space-4); }
  .timeline h3 { margin-block: 4px; font-size: clamp(16px, 5.4vw, var(--fs-md)); overflow-wrap: anywhere; }
  @media (min-width: 700px) { .timeline h3 { font-size: var(--fs-md); } }
  .skills { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: var(--space-3) var(--gutter); }
  .skills div { border-top: 1px solid var(--line); padding-top: var(--space-1); }
  .certs { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-bottom: var(--space-2); }

  /* screen layout */
  @media screen {
    .tl { position: relative; --tl-x: 0px; --tl-pad: var(--space-3); }
    .tl > section + section { margin-top: var(--space-5); }
    .tl-line { position: absolute; top: 0; bottom: 0; left: var(--tl-x); width: 1.5px; margin-left: -0.75px; background: var(--accent); transform-origin: top; }
    .tl h2 { padding-left: var(--tl-pad); }
    .role { position: relative; padding-left: var(--tl-pad); }
    .node { position: absolute; left: calc(var(--tl-x) - 4.5px); top: 5px; width: 9px; height: 9px; background: var(--accent); transition: background var(--dur-ui) var(--ease-tide); }
    .armed .node { background: transparent; box-shadow: inset 0 0 0 1.5px var(--accent); }
    .armed .role.on .node { background: var(--accent); }
    .date { display: block; }
    .has-motion .tl :is(h2, h3) { visibility: hidden; animation: cv-show 0s 3s forwards; } /* shown by the scene once the lines are masked; the animation is the net if the scene never loads */

    .skills { grid-template-columns: 1fr; gap: 0; border-bottom: 1px solid var(--line); }
    .skills div { display: grid; grid-template-columns: 1fr; gap: var(--space-1); padding-block: var(--space-2); }
    .skills dd { font-size: var(--fs-md); line-height: 1.35; max-width: 60ch; }
    .certs { display: block; border-top: 1px solid var(--line); }
    .certs li { padding-block: var(--space-1); border-bottom: 1px solid var(--line); font-size: var(--fs-base); }
    .cv-end .horizon { transform-origin: left; }
    .has-motion .cv-line { animation: cv-draw var(--dur-scene) var(--ease-tide) both; }
    .has-motion header :is(h1, .cta, .summary) { animation: cv-up var(--dur-reveal) var(--ease-tide) both; }
    .has-motion header .cta { animation-delay: var(--stagger); }
    .has-motion header .summary { animation-delay: calc(var(--stagger) * 2); }
  }
  @media screen and (min-width: 900px) {
    .tl { --tl-x: 224px; --tl-pad: var(--space-4); }
    .tl h2 { padding-left: calc(var(--tl-x) + var(--tl-pad)); }
    .role { display: grid; grid-template-columns: var(--tl-x) minmax(0, 1fr); padding-left: 0; }
    .role > :not(.node):not(.date) { grid-column: 2; margin-left: var(--tl-pad); }
    .role > .date { grid-column: 1; grid-row: 1 / span 6; align-self: start; position: sticky; top: var(--space-4); }
    .skills div { grid-template-columns: var(--tl-x, 224px) 1fr; column-gap: var(--tl-pad, 48px); }
    .skills { --tl-x: 224px; --tl-pad: var(--space-4); }
  }
  @keyframes cv-show { to { visibility: visible; } }
  @keyframes cv-draw { from { transform: scaleX(0); } }
  @keyframes cv-up { from { opacity: 0; transform: translateY(var(--space-2)); } }
</style>
