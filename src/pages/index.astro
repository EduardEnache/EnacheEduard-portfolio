---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Facts from '../components/home/Facts.astro';
import Join from '../components/home/Join.astro';
import Work from '../components/home/Work.astro';
import { ditherCss } from '../components/home/masks';
import { site } from '../data/site';
import '../components/home/hero.css';
import '../components/home/work.css';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const facts = [
  { label: 'Now', value: site.role, note: site.org },
  { label: 'MSc Mobile Communications', value: '9.14 / 10', note: site.subline },
  { label: 'Built', value: `${projects.length} projects`, note: 'From the scraper to the monitoring, most of them live.' },
];
---
<Base>
  <div class="home">
  <!-- motion layer switch: set on the page's own wrapper so it survives view transitions; no script, no class, static page -->
  <script is:inline data-astro-rerun>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.parentElement.classList.add('has-motion');
  </script>
  <style is:inline set:html={ditherCss()}></style>
  <Hero />
  <Join from="water-900" to="haze-100" />
  <Facts facts={facts} />
  <Join from="haze-100" to="water-900" />
  <Work projects={projects} />

  <section class="cta-band section wrap ground-water" data-scene="contact-cta">
    <h2>Let's talk</h2>
    <p>Open to QA, data and platform roles, and to interesting collaborations.</p>
    <p><a class="btn btn-primary" href="/contact/">Get in touch</a></p>
  </section>
  </div>
</Base>

<script>
  import '../scripts/scenes/fan';
</script>

<style>
  .cta-band p { margin-bottom: var(--space-3); }
  .cta-band .btn { color: var(--water-900); }
</style>
