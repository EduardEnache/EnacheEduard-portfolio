# Copy to .env (chmod 600). Real values never get committed.
PROMETHEUS_URL=http://prometheus-host:9090
CASATA_API_URL=http://casata-api-host:8000
MC_BRIDGE_URL=http://mc-bridge-host:8080
BLUEMAP_URL=https://bluemap.example.com/
# Docker networks the API joins to reach the three sources above (read-only use)
NET_PROMETHEUS=prometheus_network
NET_CASATA=casata_network
NET_MINECRAFT=minecraft_network
HOST_PORT=8506
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# The web container's fixed address (see docker-compose.yml). Only a TCP peer with this address may set x-real-ip.
TRUSTED_PROXY_IP=172.29.0.10
WEB_SUBNET=172.29.0.0/24
WEB_GATEWAY=172.29.0.1
WEB_IP=172.29.0.10 # must equal TRUSTED_PROXY_IP
